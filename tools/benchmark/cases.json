      "hardChecks": {
        "requireZeroPreSnapErrors": true,
        "requireZeroPostWarnings": true,
        "maxSnapFixCount": 0,
        "minFloors": 3,
        "minRooms": 5,
        "minObjects": 3,
        "minStairs": 2,
        "requireStairBottom": true,
        "minVerticalOverlapPairs": 2,
        "requireOpenCourtyardOrEdge": true,
        "maxCourtyardCoverRatio": 0.65,
        "maxDeadEndRatio": 0,
        "maxEmptyCombatRooms": 0,
        "minDoorEnemyDistM": 2.3,
        "zeroUnreachableRooms": true,
        "mustContainRouteKinds": ["main"]
