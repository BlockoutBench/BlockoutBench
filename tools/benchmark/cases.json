{
  "version": "2.0",
  "title": "LevelWorkbench 商业级白盒评测题库 v2（L1～L6）",
  "cases": [
    {
      "id": "L1-01-gallery-loop",
      "tier": "L1",
      "title": "单层展馆回环拼接",
      "mode": "create",
      "prompt": "设计一座单层博物馆展厅（4～7 间房，bounds 清晰，player.radius=0.35m）。需要包含入口门厅、主展厅、侧翼回廊与离场廊，通过至少 1 条绕行回环连接主展厅与侧翼，不能出现孤立房或无回报死胡同；所有大型战斗厅（≥6×6m）需配置展台/掩体，敌人不要紧贴门洞刷新。输出符合 AI_MAP_SPEC v1 或相对贴靠格式（size/attach、door.between）的纯 JSON。",
      "hardChecks": {
        "requireZeroPreSnapErrors": true,
        "requireZeroPostWarnings": true,
        "maxSnapFixCount": 0,
        "minFloors": 1,
        "minRooms": 4,
        "maxRooms": 7,
        "minLoopCount": 1,
        "maxDeadEndRatio": 0,
        "zeroUnreachableRooms": true,
        "maxEmptyCombatRooms": 0,
        "minDoorEnemyDistM": 2.3,
        "mustContainRouteKinds": ["main", "optional"]
      }
    },
    {
      "id": "L1-02-warehouse-extraction",
      "tier": "L1",
      "title": "密集掩体仓库与多线撤离",
      "mode": "create",
      "prompt": "设计一座单层中转仓库白盒（5～9 间房，player.radius=0.35m）。包含至少 5 处实体掩体（货箱/柱阵），交火区需有掩护且不得阻塞任何 main/exit 路线，也不要在门口贴脸刷怪；整体形成可绕行环路，没有无回报死胡同，并明确标出主攻与撤离路线（撤离点用 kind: \"extract\"）。",
      "hardChecks": {
        "requireZeroPreSnapErrors": true,
        "requireZeroPostWarnings": true,
        "maxSnapFixCount": 0,
        "minFloors": 1,
        "minRooms": 5,
        "maxRooms": 9,
        "minSolidCover": 5,
        "minLoopCount": 1,
        "maxDeadEndRatio": 0,
        "zeroUnreachableRooms": true,
        "maxEmptyCombatRooms": 0,
        "minDoorEnemyDistM": 2.3,
        "mustContainRouteKinds": ["main", "exit"]
      }
    },
    {
