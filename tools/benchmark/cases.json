    {
      "id": "L4-01-patch-fix-and-branch",
      "tier": "L4",
      "title": "局部 { patch } 修缺陷并扩建有回报安全侧室",
      "mode": "patch",
      "baseMap": "tools/benchmark/fixtures/l4-base-broken.json",
      "prompt": "读取给定的残次地图与批注：1）把脱边北门 d_north 吸附回 r_entry 与 r_north 共享边；2）把挡住主线净空的展柜 o_case_block 挪到不阻挡路线的位置；3）在 r_entry 东侧新增 6×6 安全休整侧室 r_safe、连通门 d_safe 以及室内休整/补给物件与可选探索线，不能留下空壳无回报尽头。只输出 { \"patch\": ... } 增量 JSON，严禁改动 r_entry、r_north、e_guard 等无关既有实体。",
      "hardChecks": {
        "requireZeroPreSnapErrors": true,
        "requireZeroPostWarnings": true,
        "maxSnapFixCount": 0,
        "zeroUnreachableRooms": true,
        "maxDeadEndRatio": 0,
        "mustIncludeIds": ["r_safe", "d_safe"],
        "preserveIds": ["r_entry", "r_north", "e_guard"],
        "allowedEditIds": ["d_north", "o_case_block"],
        "zeroCollateralEdits": true
