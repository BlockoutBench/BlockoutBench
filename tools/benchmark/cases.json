      "id": "L3-01-dual-lock-relay",
      "tier": "L3",
      "title": "双锁机关状态机与零死锁",
      "mode": "create",
      "prompt": "设计一座带机关锁闭的密室关卡（至少 4 间房）：宝库门或石闸初始处于关闭/阻挡状态（initial: closed 或 states solid: true，若用 stone-gate 等高墙物件请写明合理高度），玩家需在可达前置分支中触发 2 个以上开关与联动 links 逐级解锁后才能进入终点宝库。严禁把开关锁在待开启的门后导致死锁，战斗房内不要贴门刷怪且需有掩护。",
      "hardChecks": {
        "requireZeroPreSnapErrors": true,
        "requireZeroPostWarnings": true,
        "maxSnapFixCount": 0,
        "minRooms": 4,
        "minLinks": 2,
        "noDeadlock": true,
        "maxDeadEndRatio": 0,
        "maxEmptyCombatRooms": 0,
        "minDoorEnemyDistM": 2.0,
        "zeroUnreachableRooms": true,
        "mustContainRouteKinds": ["main"]
